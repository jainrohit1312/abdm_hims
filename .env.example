# ---------------------------------------------------------------------------
# Vercel Environment Variables (Project Settings → Environment Variables)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local tooling. Never commit real `.env`
# files to Git — Vercel injects these values into the build environment, and
# the `vercel-build` script in package.json writes them into `web/env.js` and
# passes them to Flutter as `--dart-define` values.
#
# Runtime resolution order (see lib/config/supabase_web_config.dart):
#   1. window._env_          (web runtime, generated from these vars)
#   2. --dart-define values  (build-time, generated from these vars)
#   3. Local-dev fallbacks   (hard-coded in supabase_web_config.dart)
# ---------------------------------------------------------------------------

# Supabase project URL — Project Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — Project Settings → API → anon public
# This key is safe to expose to browsers (RLS protects your data).
# NEVER use the service_role key in a Flutter web app.
SUPABASE_ANON_KEY=your-supabase-anon-key

# DeepSeek API key — https://platform.deepseek.com
# WARNING: client-side apps cannot keep this secret. For production, proxy the
# DeepSeek call through a Supabase Edge Function instead of exposing the key.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ---------------------------------------------------------------------------
# ABDM (Ayushman Bharat Digital Mission) secrets
# ---------------------------------------------------------------------------
# ABDM_CLIENT_ID / ABDM_CLIENT_SECRET / ABDM_BRIDGE_ID / ABDM_HIP_ID /
# ABDM_HIU_ID / ABDM_CALLBACK_BASE_URL must ONLY exist as Supabase Edge
# Function secrets. NEVER add them here, to web/env.js, or to --dart-define.
# See docs/ABDM_SANDBOX_SETUP.md.
# ---------------------------------------------------------------------------

# ABDM real-mode build flag (non-secret boolean).
#   * false (default) — the app runs in ABDM mock mode and never calls ABDM.
#   * true            — privileged ABDM calls route through the secure
#                       `abdm-gateway` Supabase Edge Function.
#
# Vercel Production must set ABDM_REAL_MODE=true only AFTER the secure
# `abdm-gateway` Edge Function is deployed and its Supabase secrets are
# configured. The value is passed to `flutter build web` as a --dart-define
# by the `vercel-build` script in package.json.
ABDM_REAL_MODE=false
